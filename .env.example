# ==============================================================================
# Profarm Shiraz - Production Server Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base Application Domain & URLs
# ------------------------------------------------------------------------------
# حتماً با پروتکل https و دامنه واقعی سرور تنظیم شود (مثال: https://profarm-shiraz.ir)
NEXT_PUBLIC_APP_URL="https://profarm-shiraz.ir"

# ------------------------------------------------------------------------------
# 2. Authentication & Cryptographic Secrets
# ------------------------------------------------------------------------------
# یک کلید تصادفی امن ۳۲+ کاراکتری (با دستور: openssl rand -base64 32 تولید کنید)
NEXTAUTH_SECRET="replace_with_a_secure_random_32_char_secret_key"
NEXTAUTH_URL="https://profarm-shiraz.ir"

# رمز عبور اولیه حساب مدیر ارشد در هنگام اولین استقرار
ADMIN_INITIAL_PASSWORD="YourStrongAdminPassword2026!#"
ADMIN_PASSWORD="YourStrongAdminPassword2026!#"

# تعیین اجباری بودن کوکی‌های HTTPS (در صورتی که سایت هنوز SSL ندارد false بگذارید)
COOKIE_SECURE="true"

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# رشته اتصال به پایگاه داده سرور لوکال یا داکر یا ابری (لیارا، آروان، Supabase)
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/profarm_db?schema=public"

# ------------------------------------------------------------------------------
# 4. Official Payment Gateways (شبکه پرداخت الکترونیک شاپرک)
# ------------------------------------------------------------------------------
# مرچنت کد ۳۶ کاراکتری اختصاصی درگاه زرین‌پال
ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
# در محیط عملیاتی و واقعی مقدار false قرار دهید
ZARINPAL_SANDBOX="false"

# درگاه پرداخت اقساطی ۴ ماهه اسنپ‌پی (در صورت داشتن قرارداد)
SNAPPPAY_CLIENT_ID=""
SNAPPPAY_CLIENT_SECRET=""
SNAPPPAY_BASE_URL="https://api.snapppay.ir/api/online/v1"

# ------------------------------------------------------------------------------
# 5. SMS & OTP Web-Services (سامانه پیامک و کد تایید)
# ------------------------------------------------------------------------------
# انتخاب سرویس پیامک: KAVENEGAR یا FARAZ_SMS یا MOCK
SMS_PROVIDER="KAVENEGAR"
# کلید وب‌سرویس اختصاصی پنل پیامک
SMS_API_KEY="your_sms_provider_api_key"
# سرشماره خط ارسال‌کننده پیامک
SMS_SENDER_LINE="10008585"
# کد الگوی وب‌سرویس اعتبارسنجی سریع (اختیاری در کاوه‌نگار/فراز)
SMS_PATTERN_CODE="profarm-otp"

# ------------------------------------------------------------------------------
# 6. Email & SMTP Notification Server (اختیاری جهت فال‌بک و ارسال ایمیل سفارش)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER="SMTP"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-specific-password"
SMTP_FROM_EMAIL="info@profarm-shiraz.ir"
SMTP_FROM_NAME="مزارع ارگانیک پروفارم شیراز"
SMTP_SECURE="false"

# ------------------------------------------------------------------------------
# 7. Google OAuth Sign-In (اختیاری - ورود با گوگل)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ------------------------------------------------------------------------------
# 8. Shiraz Logistics & Farm Settings
# ------------------------------------------------------------------------------
STORE_CITY="شیراز"
STORE_PROVINCE="فارس"

# ------------------------------------------------------------------------------
# 9. Optional Distributed Rate-Limiting (Upstash Redis)
# ------------------------------------------------------------------------------
# در صورت اجرای چند نود همزمان (کلاسترینگ توزیع‌شده)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------------------------
# 10. Proxy trust & admin recovery (امنیتی)
# ------------------------------------------------------------------------------
# فقط وقتی سایت پشت CDN یا پروکسی است که هدرهای IP را بازنویسی می‌کند (nginx با X-Real-IP، ArvanCloud، Cloudflare) مقدار 1 بگذارید.
# در غیر این صورت هدرهای IP قابل جعل‌اند و محدودیت‌های تلاش (ورود، OTP، کد تخفیف) قابل دور زدن هستند.
# بدون این متغیر، همه درخواست‌ها یک سطل مشترک 'unknown' دارند (محدودیت‌های IP برای کل سایت مشترک می‌شوند).
# TRUST_PROXY_HEADERS="1"
#
# بازیابی رمز عبور مدیر: با تنظیم ADMIN_PASSWORD (یا ADMIN_INITIAL_PASSWORD) و این پرچم، رمز مدیر در هر راه‌اندازی تنظیم می‌شود.
# بعد از بازیابی حتماً این خط را حذف کنید.
# ADMIN_PASSWORD_RESET="1"
